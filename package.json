{
  "name": "copilotkit-langgraph-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:infra && concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:ui": "next dev --turbopack",
    "dev:agent": "./scripts/run-agent.sh || scripts\\run-agent.bat",
    "build": "next build",
    "start": "next start",
    "install:agent": "./scripts/setup-agent.sh || scripts\\setup-agent.bat",
    "reset:agent": "rm -f agent/.journal/actions.jsonl",
    "postinstall": "npm run install:agent",
    "channel": "tsx --tsconfig tsconfig.channel.json channel-host.mts",
    "typecheck:channel": "tsc -p tsconfig.channel.json --noEmit",
    "dev:infra": "node scripts/copilotkit-dev-infra.mjs"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "1.70.0",
    "@copilotkit/channels": "0.9.0",
    "@copilotkit/react-core": "1.70.0",
    "@copilotkit/runtime": "1.70.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "dotenv": "^16.4.7",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.12.4",
    "react-rnd": "^10.5.2",
    "react18-json-view": "^0.2.9",
    "recharts": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
